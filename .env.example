# Supabase project (Dashboard -> Project Settings -> API). The anon / publishable
# key is public; never put the service_role key here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Used only by the agent (agent/ask.ts).
ANTHROPIC_API_KEY=sk-ant-...

# Where the consent screen is served (npm run web).
WEB_URL=http://localhost:3000
